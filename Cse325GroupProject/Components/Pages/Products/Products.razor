@page "/inventory"
@using Cse325GroupProject.Models
@using Cse325GroupProject.Services
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject ClothingProductService ProductService
@inject ProtectedSessionStorage SessionStorage
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<PageTitle>Inventory Management</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold text-primary">Inventory Management</h1>
        @if (canCreate)
        {
            <button class="btn btn-primary shadow-sm" @onclick="PrepareCreate">
                <i class="bi bi-plus-lg"></i> Add New Product
            </button>
        }
    </div>

    @if (statusMessage != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @statusMessage
            <button type="button" class="btn-close" @onclick="() => statusMessage = null" aria-label="Close"></button>
        </div>
    }

    @if (showForm)
    {
        <div class="card mb-4 shadow border-0">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">@(isEditing ? "Edit Product" : "Add New Product")</h5>
            </div>
            <div class="card-body p-4">
                <EditForm Model="@currentProduct" OnValidSubmit="SaveProduct">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger small" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="name" class="form-label fw-semibold">Name</label>
                            <InputText id="name" class="form-control" @bind-Value="currentProduct.Name"
                                placeholder="Enter product name" />
                        </div>
                        <div class="col-md-6">
                            <label for="category" class="form-label fw-semibold">Category</label>
                            <InputText id="category" class="form-control" @bind-Value="currentProduct.Category"
                                placeholder="e.g. Shirts, Pants" />
                        </div>
                        <div class="col-md-4">
                            <label for="size" class="form-label fw-semibold">Size</label>
                            <InputText id="size" class="form-control" @bind-Value="currentProduct.Size"
                                placeholder="S, M, L, XL" />
                        </div>
                        <div class="col-md-4">
                            <label for="quantity" class="form-label fw-semibold">Quantity</label>
                            <InputNumber id="quantity" class="form-control" @bind-Value="currentProduct.Quantity" />
                        </div>
                        <div class="col-md-4">
                            <label for="location" class="form-label fw-semibold">Location</label>
                            <InputText id="location" class="form-control" @bind-Value="currentProduct.Location"
                                placeholder="Shelf A1" />
                        </div>
                        <div class="col-md-6">
                            <label for="provider" class="form-label fw-semibold">Provider Name</label>
                            <InputText id="provider" class="form-control" @bind-Value="currentProduct.ProviderName" />
                        </div>
                        <div class="col-md-6">
                            <label for="expiration" class="form-label fw-semibold">Expiration Date</label>
                            <InputDate id="expiration" class="form-control" @bind-Value="currentProduct.ExpirationDate" />
                        </div>
                    </div>

                    <div class="mt-4 d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CancelForm">Cancel</button>
                        <button type="submit" class="btn btn-success px-4" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            }
                            Save Product
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    @if (products == null)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2 text-muted">Loading inventory...</p>
        </div>
    }
    else if (!products.Any())
    {
        <div class="alert alert-info shadow-sm bg-white border-info text-center p-5">
            <i class="bi bi-info-circle fs-1 text-info mb-3 d-block"></i>
            <h4>No products found</h4>
            <p class="text-muted">Start by adding your first product to the inventory.</p>
            @if (canCreate)
            {
                <button class="btn btn-primary mt-2" @onclick="PrepareCreate">
                    <i class="bi bi-plus-lg"></i> Add New Product
                </button>
            }
        </div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-hover align-middle mb-0 bg-white">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-3">Name</th>
                        <th>Category</th>
                        <th>Size</th>
                        <th>Qty</th>
                        <th>Location</th>
                        <th>Provider</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in products)
                    {
                        <tr>
                            <td class="ps-3 fw-medium">@product.Name</td>
                            <td><span class="badge bg-light text-dark border">@product.Category</span></td>
                            <td>@product.Size</td>
                            <td>
                                <span class="fw-bold @(product.Quantity < 10 ? "text-danger" : "text-success")">
                                    @product.Quantity
                                </span>
                            </td>
                            <td><i class="bi bi-geo-alt-fill text-muted me-1"></i>@product.Location</td>
                            <td>@product.ProviderName</td>
                            <td class="text-end pe-3">
                                <div class="btn-group shadow-sm">
                                    @if (canEdit)
                                    {
                                        <button class="btn btn-sm btn-white border px-3" @onclick="() => PrepareEdit(product)" title="Edit">
                                            <i class="bi bi-pencil text-primary me-1"></i> Edit
                                        </button>
                                    }
                                    @if (canDelete)
                                    {
                                        <button class="btn btn-sm btn-white border px-3" @onclick="() => ConfirmDelete(product.Id)" title="Delete">
                                            <i class="bi bi-trash text-danger me-1"></i> Delete
                                        </button>
                                    }
                                </div>
                                @if (!canEdit && !canDelete)
                                {
                                    <span class="text-muted small italic">View only</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<Product>? products;
    private Product currentProduct = new();
    private bool showForm = false;
    private bool isEditing = false;
    private bool isSaving = false;
    private string? statusMessage;
    
    // RBAC Permissions
    private string? userRole;
    private bool canCreate => userRole == "admin" || userRole == "employee";
    private bool canEdit => userRole == "admin" || userRole == "employee";
    private bool canDelete => userRole == "admin";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var authResult = await SessionStorage.GetAsync<string>("authToken");
            if (!authResult.Success || string.IsNullOrEmpty(authResult.Value))
            {
                // Redirect unauthenticated users as requested
                Navigation.NavigateTo("/signin");
                return;
            }
            else
            {
                var roleResult = await SessionStorage.GetAsync<string>("userRole");
                userRole = roleResult.Success ? roleResult.Value : "customer";
            }
            
            await LoadProducts();
            StateHasChanged();
        }
    }

    private async Task LoadProducts()
    {
        try
        {
            products = await ProductService.GetAllAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading products: {ex.Message}");
        }
    }

    private void PrepareCreate()
    {
        currentProduct = new Product { ExpirationDate = DateTime.Now.AddMonths(1) };
        isEditing = false;
        showForm = true;
        statusMessage = null;
    }

    private void PrepareEdit(Product product)
    {
        currentProduct = new Product
        {
            Id = product.Id,
            Name = product.Name,
            Category = product.Category,
            Size = product.Size,
            Quantity = product.Quantity,
            Location = product.Location,
            ProviderName = product.ProviderName,
            ExpirationDate = product.ExpirationDate
        };
        isEditing = true;
        showForm = true;
        statusMessage = null;
    }

    private void CancelForm()
    {
        showForm = false;
        currentProduct = new Product();
    }

    private async Task SaveProduct()
    {
        isSaving = true;
        try
        {
            if (isEditing)
            {
                await ProductService.UpdateAsync(currentProduct.Id, currentProduct);
                statusMessage = "Product updated successfully!";
            }
            else
            {
                await ProductService.CreateAsync(currentProduct);
                statusMessage = "Product added successfully!";
            }

            showForm = false;
            await LoadProducts();
        }
        catch (Exception ex)
        {
            statusMessage = "Error saving product: " + ex.Message;
            Console.WriteLine($"Error saving product: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ConfirmDelete(string id)
    {
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this product?");
        if (confirmed)
        {
            try
            {
                await ProductService.DeleteAsync(id);
                statusMessage = "Product deleted successfully!";
                await LoadProducts();
            }
            catch (Exception ex)
            {
                statusMessage = "Error deleting product: " + ex.Message;
                Console.WriteLine($"Error deleting product: {ex.Message}");
            }
        }
    }
}
